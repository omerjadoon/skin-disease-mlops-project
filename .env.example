# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=mlops
POSTGRES_PASSWORD=mlops_secret
POSTGRES_DB=mlops_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── MLflow ───────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
MLFLOW_EXPERIMENT_NAME=skin-severity-experiment

# ─── MinIO / S3 ───────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
MINIO_ENDPOINT=http://minio:9000

# ─── Model ────────────────────────────────────────────────────
MODEL_NAME=skin-severity-classifier
MODEL_STAGE=Production
MODEL_LOCAL_PATH=/app/artifacts/model.ckpt

# ─── Airflow ──────────────────────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://mlops:mlops_secret@postgres:5432/airflow_db
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here_change_in_production
AIRFLOW__WEBSERVER__SECRET_KEY=your_secret_key_here_change_in_production
AIRFLOW_UID=50000

# ─── API ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_PREDICTIONS=true

# ─── FiftyOne ─────────────────────────────────────────────────
FIFTYONE_DATABASE_URI=mongodb://fiftyone-mongo:27017

# ─── Metabase ─────────────────────────────────────────────────
MB_DB_TYPE=postgres
MB_DB_DBNAME=metabase_db
MB_DB_PORT=5432
MB_DB_USER=mlops
MB_DB_PASS=mlops_secret
MB_DB_HOST=postgres
